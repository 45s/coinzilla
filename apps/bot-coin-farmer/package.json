{
  "name": "@coinzilla/bot-coin-farmer",
  "version": "1.0.0",
  "private": true,
  "description": "CEX-agnostic Coin Farmer application",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module",
  "dependencies": {
    "@coinzilla/event-bus": "workspace:*",
