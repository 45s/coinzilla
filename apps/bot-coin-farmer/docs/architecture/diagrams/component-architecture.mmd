flowchart TB
  subgraph runtime["Runtime / composition"]
    entry["index.js"]
    config["JSON config + env secrets"]
    lifecycle["startup / shutdown"]
  end
  subgraph application["Application"]
    coordinator["Strategy coordinator"]
    workflows["Market / order / fill / reconcile / recovery workflows"]
    ports["CEX-neutral broker + state + event + notification + clock ports"]
  end
  subgraph domain["Domain"]
    policy["BUY planner + SELL profitability gate"]
    ledger["Fill ledger + inventory + recovery-cycle accounting"]
    state["Per-market state machine"]
  end
  subgraph adapters["Adapters"]
    binance["Binance WebSocket broker"]
    telegram["Telegram notifier"]
    eventAdapter["EventBus adapter"]
    journal["Journal adapter"]
    persistence["In-memory repository\nthen durable adapter"]
  end
  entities["@coinzilla/entities\ncanonical shared contracts"]

  entry --> config
  entry --> lifecycle
  lifecycle --> coordinator
  coordinator --> workflows
  workflows --> ports
  workflows --> policy
  workflows --> ledger
  workflows --> state
  ports -. implemented by .-> adapters
  policy --> entities
  ledger --> entities
  binance --> entities
  eventAdapter --> journal