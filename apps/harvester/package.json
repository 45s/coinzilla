{
  "name": "@coinzilla/harvester",
  "version": "1.0.0",
  "private": true,
  "description": "Harvester application workspace",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "start": "node src/index.js",
    "dev": "node --env-file=.env.development src/index.js",
    "testnet:orders": "node --env-file=.env.development scripts/list-testnet-open-orders.js",
    "testnet:cancel-orders": "node --env-file=.env.development scripts/cancel-testnet-open-orders.js",
    "testnet:balances": "node --env-file=.env.development scripts/list-testnet-balances.js",
    "testnet:sell-zro": "node --env-file=.env.development scripts/sell-testnet-zro.js",
    "testnet:history": "node --env-file=.env.development scripts/list-testnet-order-history.js"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "dependencies": {
    "@coinzilla/brokers": "workspace:*",
    "@coinzilla/entities": "workspace:*",
    "@coinzilla/event-bus": "workspace:*",
    "@coinzilla/journal": "workspace:*",
    "@coinzilla/utils": "workspace:*"
  }
}
