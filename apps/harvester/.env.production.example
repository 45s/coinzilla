NODE_ENV="production"

# Binance Spot LIVE credentials. Use a dedicated API key with Spot trading permission and withdrawals disabled.
# Copy this file to .env; NODE_ENV selects the production LIVE runtime profile.
BINANCE_API_KEY=""
BINANCE_API_SECRET_KEY=""

# Optional Telegram alerts. Leave both empty to disable notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
