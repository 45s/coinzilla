TRADING_MODE=testnet

# Binance Spot API credentials for the selected TRADING_MODE.
# TESTNET and LIVE require separate API keys. LIVE permits real orders; withdrawals must remain disabled.
BINANCE_API_KEY=""
BINANCE_API_SECRET_KEY=""

# Optional Telegram alerts. Leave both empty to disable notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional inbound Telegram Command Center authorization (numeric sender user ID).
# Bootstrap validates this and adds it to operatorControl.telegram.allowedUserIds.
# It does not enable operator control by itself.
TELEGRAM_USER_ID=""
