NODE_ENV="development"
HARVESTER_BROKER="" # Set to binance to connect the configured broker
HARVESTER_TRADING_MODE="testnet"
HARVESTER_ENABLE_TRADING="false" # Set true to opt in to the first Conservative TESTNET trading cycle
HARVESTER_ENABLE_AGGRESSIVE="false" # Keep false; Aggressive is deferred until Conservative is proven on TESTNET
HARVESTER_JOURNAL_ENABLED="true" # Optional observer; set false to disable local JSONL journaling
HARVESTER_JOURNAL_DIRECTORY="./logs" # Relative to apps/harvester unless an absolute path is supplied
