TRADING_MODE=testnet

# Stable, non-secret identity labels for the single Binance provider instance.
# Non-secret identity labels only; never put API credentials here.
# Defaults: binanceTestnet / binanceLive (selected by TRADING_MODE), and binance-primary.
# Set BINANCE_ACCOUNT_ID when this deployment represents a different Binance Spot account.
# BINANCE_PROVIDER_INSTANCE_ID="binanceTestnet"
# BINANCE_ACCOUNT_ID="binance-primary"

# Binance Spot API credentials for the selected TRADING_MODE.
# TESTNET and LIVE require separate API keys. LIVE permits real orders; withdrawals must remain disabled.
BINANCE_API_KEY=""
BINANCE_API_SECRET_KEY=""

# Optional Telegram alerts. Leave both empty to disable notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional inbound Telegram Command Center authorization (numeric sender user ID).
# Bootstrap validates this and adds it to operatorControl.telegram.allowedUserIds.
# It does not enable operator control by itself.
TELEGRAM_USER_ID=""

# Optional absolute override for the Operational State Store.
# Default: ./recovery-facts/ under apps/harvester (resolved from source location).
# Set this only when an alternate absolute local-filesystem path is required.
# OPERATIONAL_STATE_DIRECTORY="/absolute/path/to/operational-state"

# Optional absolute local-filesystem base directory for ordinary trading-session history (SQLite initially).
# TRADING_MODE=live selects production/harvester.db; testnet selects testnet/harvester.db.
# Use an explicit stable persistent path for production; the package-local ./data/ default is Git-ignored.
# SQLite WAL requires same-host local storage: never use NFS/SMB or a shared network volume.
# Apply restrictive service-account ownership/permissions; current path creation relies on OS defaults/umask.
# HARVESTER_DATABASE_DIRECTORY="/absolute/path/to/harvester-data"

# Optional in-process trading-history API. A non-empty token enables the HTTP listener inside Harvester.
# Generate a strong local token with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this secret in the local .env/.env.development file; never commit the generated value.
# Harvester starts the API with its normal process and closes it before database shutdown.
# The API binds to loopback by default. Use a TLS reverse proxy and firewall before remote exposure.
HARVESTER_API_PORT="4201"
