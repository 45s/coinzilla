{
  "name": "@coinzilla/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./testing": "./test-support/provider-conformance.js"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=95 --test-coverage-functions=100 --test-coverage-include=src/**/*.js --test-coverage-exclude=src/**/*.test.js --test-coverage-exclude=../utils/src/**/*.js",
    "test:coverage": "pnpm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@coinzilla/utils": "workspace:*"
  }
}
