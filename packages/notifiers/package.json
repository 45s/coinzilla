    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-include=src/index.js --test-coverage-include=src/telegram/index.js --test-coverage-include=src/telegram/notifier.js --test-coverage-include=src/telegram/helpers/run-validation.js --test-coverage-include=src/telegram/helpers/get-safe-error-msg.js --test-coverage-include=src/telegram/event-subscriber.js --test-coverage-exclude=src/**/*.test.js",
