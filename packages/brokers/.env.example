# Copy to .env.development and replace placeholders with Binance TESTNET credentials.
# Selects the exchange endpoints used by the broker.
TRADING_MODE=testnet
# Set to 1 only when intentionally running live Binance TESTNET integration tests.
BINANCE_TESTNET_INTEGRATION=0
# Set to 1 only when intentionally placing and cancelling a TESTNET order.
# This is independent of BINANCE_TESTNET_INTEGRATION and defaults to disabled.
BINANCE_TESTNET_ALLOW_ORDER_MUTATIONS=0
BINANCE_API_KEY=replace-with-your-binance-testnet-api-key
BINANCE_API_SECRET_KEY=replace-with-your-binance-testnet-api-secret

# Optional Bitunix read-only diagnostics.
# Omit both credentials to run public REST checks only.
# Configure both to enable private account reads and authenticated WebSocket RPC.
# BITUNIX_API_KEY=
# BITUNIX_API_SECRET=
# Optional: explicitly selected depth precision; without it, REST and WebSocket depth checks are skipped.
# BITUNIX_DIAGNOSTICS_DEPTH_PRECISION=
