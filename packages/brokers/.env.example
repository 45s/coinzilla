# Copy to .env.development and replace placeholders with Binance TESTNET credentials.
# Integration tests refuse to run when NODE_ENV=production.
# Set to 1 only when intentionally running live Binance TESTNET integration tests.
BINANCE_TESTNET_INTEGRATION=0
NODE_ENV=development
BINANCE_API_KEY=replace-with-your-binance-testnet-api-key
BINANCE_API_SECRET_KEY=replace-with-your-binance-testnet-api-secret
