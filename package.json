  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.2"
    }
  }
}
