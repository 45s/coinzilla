{
  "name": "coinzilla",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "eslint": "~10.15.0",
    "globals": "~17.14.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:changed": "node scripts/lint-changed.js",
    "lint:fix": "eslint . --fix",
    "test": "node --test scripts/cli-identity.test.js && pnpm --recursive --if-present test",
    "test:coverage": "pnpm --filter './packages/*' --filter './apps/*' --recursive exec node --test --experimental-test-coverage",
    "test:external-links": "node --test scripts/check-external-links.test.js",
    "test:module-dependency-analysis": "node --test scripts/module-import-analysis.test.js scripts/module-import-resolution.test.js scripts/module-dependency-graph.test.js scripts/module-dependency-cycles.test.js scripts/repository-module-discovery.test.js scripts/repository-module-graph-report.test.js",
    "test:sync-main": "node --test scripts/sync-main.test.js",
    "check:agent-policy": "node --test scripts/check-agent-policy.test.js && node scripts/check-agent-policy.js",
    "check:external-links": "node scripts/check-external-links.js",
    "check:helper-names": "node --test scripts/check-helper-policy.test.js && node scripts/check-helper-policy.js --check-names",
    "check:helper-names:changed": "node --test scripts/check-helper-policy.test.js && node scripts/check-helper-policy.js --changed-names",
    "check:helper-policy": "node --test scripts/check-helper-policy.test.js && node scripts/check-helper-policy.js",
    "check:module-names": "node --test scripts/check-module-naming.test.js && node scripts/check-module-naming.js --check",
    "check:module-names:changed": "node --test scripts/check-module-naming.test.js && node scripts/check-module-naming.js --changed",
    "check:syntax": "node --check scripts/check-syntax.js && node scripts/check-syntax.js",
    "check:test-matrix": "node --test scripts/workspace-test-matrix.test.js && node scripts/check-workspace-test-matrix.js",
    "check:workspace-dependency-policy": "node --test scripts/workspace-dependency-policy.test.js && node scripts/check-workspace-dependency-policy.js",
    "quality": "pnpm test && pnpm lint && pnpm run check:syntax && pnpm run check:agent-policy && pnpm run test:external-links",
    "report:large-modules": "node scripts/report-large-production-modules.js",
    "report:module-graph": "node scripts/report-module-graph.js",
    "db:export": "pnpm --filter @coinzilla/harvester persistence:export",
    "sync:main": "node scripts/sync-main.js",
    "server": "node scripts/run-apps.js server",
    "client": "node scripts/run-apps.js client",
    "app": "node scripts/run-apps.js app",
    "server:prod": "pnpm --filter @coinzilla/harvester start",
    "client:prod": "pnpm --filter @coinzilla/dashboard build",
    "app:prod": "node scripts/run-apps.js app:prod",
    "task:preflight": "node scripts/task-preflight.js",
    "test:task-preflight": "node --test scripts/task-preflight.test.js"
  }
}
